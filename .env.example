# ─── Aplicação ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_DOMAIN=cardapio.yugochat.com.br
NEXT_PUBLIC_CONNECT_API=https://connect.yugochat.com.br
NEXT_PUBLIC_WHATSAPP_DEFAULT=5571999952268

# ─── Banco de Dados ───────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cardapio_saas
DB_USER=cardapio
DB_PASSWORD=SENHA_FORTE_AQUI

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=SENHA_REDIS_AQUI

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERE_UM_SECRET_ALEATORIO_64_BYTES
JWT_REFRESH_SECRET=GERE_UM_SECRET_DIFERENTE_AQUI

# ─── Slave JWT (sincronização local) ─────────────────────────────────────────
# Secret SEPARADO do JWT de usuários — deve ser diferente
SLAVE_JWT_SECRET=GERE_UM_SECRET_SLAVE_AQUI

# ─── Criptografia ─────────────────────────────────────────────────────────────
# Chave AES-256: exatamente 64 caracteres hex
ENCRYPTION_KEY=GERE_UMA_CHAVE_AES256_AQUI

# ─── Admin Master ─────────────────────────────────────────────────────────────
# Usuário master criado via migration 001
MASTER_EMAIL=admin@yugochat.com.br
