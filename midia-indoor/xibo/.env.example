# ── Xibo CMS — config (copie pra .env e preencha) ──────────────────────────

# Senha do banco MySQL do Xibo (gere forte: openssl rand -hex 16)
MYSQL_PASSWORD=troque-esta-senha

# Domínio público do CMS (apontado via Cloudflare Tunnel)
CMS_SERVER_NAME=midia.tthreedigital.com.br

# ── SMTP (opcional — pra recuperação de senha / alertas) ───────────────────
# Pode reusar o mesmo servidor de e-mail do Three Digital
CMS_SMTP_SERVER=
CMS_SMTP_USERNAME=
CMS_SMTP_PASSWORD=
CMS_SMTP_USE_TLS=YES
CMS_SMTP_USE_STARTTLS=YES
CMS_SMTP_REWRITE_DOMAIN=tthreedigital.com.br
CMS_SMTP_HOSTNAME=tthreedigital.com.br
CMS_SMTP_FROM=Three Digital Midia <noreply@tthreedigital.com.br>
