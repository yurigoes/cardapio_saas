# Senha do MySQL — use uma SO PRA ESSE POC (nao reaproveite a da producao)
MYSQL_PASSWORD=poc-xibo-v4-troque

# CMS_SERVER_NAME: hostname/porta que o CMS usa pra montar URLs
# Pra acesso so local na VPS: localhost:8086
# Pra expor via Cloudflare Tunnel adicional: midia-v4.tthreedigital.com.br
CMS_SERVER_NAME=localhost:8086

# SMTP — opcional. Pra POC pode deixar vazio (nao envia email).
CMS_SMTP_SERVER=
CMS_SMTP_USERNAME=
CMS_SMTP_PASSWORD=
CMS_SMTP_FROM=
