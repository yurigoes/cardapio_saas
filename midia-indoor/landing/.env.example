# ── Three Digital Mídia — Landing/Cadastro ─────────────────────────────────

# Postgres (mesmo PG da VPS, tabelas midia_* criadas automático no boot)
# Rodando via docker-compose use host.docker.internal pra alcançar o host:
#   postgres://cardapio:SENHA@host.docker.internal:5432/cardapio_saas
# Rodando direto com node (npm start) use 127.0.0.1:
#   postgres://cardapio:SENHA@127.0.0.1:5432/cardapio_saas
DATABASE_URL=

# WhatsApp pra avisar você de lead novo (opcional — reusa Evolution do Three Digital)
EVOLUTION_API_URL=https://evolution.tthreedigital.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
NOTIFY_WHATSAPP=5571999999999

# ── URL pública da landing (back_url do MP + redirects) ────────────────────
APP_URL=https://midiaindoor.tthreedigital.com.br

# ── Auth do cliente (JWT) — troque por um segredo forte em produção ────────
JWT_SECRET=

# ── Xibo API (Administration → Applications → Client Credentials) ──────────
# XIBO_URL interno via rede Docker (mais rápido/seguro). Pública só p/ debug.
XIBO_URL=http://midia_xibo_web
XIBO_CLIENT_ID=
XIBO_CLIENT_SECRET=

# ── Mercado Pago (assinatura recorrente / PreApproval) ─────────────────────
# Access Token da conta MP. Configure o Webhook apontando p/
#   {APP_URL}/api/pagamento/webhook  (evento: assinaturas/preapproval)
MP_ACCESS_TOKEN=
