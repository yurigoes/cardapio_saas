# ─────────────────────────────────────────────────────────────────────────────
# Config da RETAGUARDA — copiar pra .env e preencher
# ─────────────────────────────────────────────────────────────────────────────

# URL completa da VPS principal (com https)
MASTER_URL=https://app.tthreedigital.com.br
MASTER_HOST=app.tthreedigital.com.br

# Domínio público desta retaguarda (apontado via DNS pro IP local do mini-PC)
# Ex: loja-shopping.tthreedigital.com.br  →  192.168.0.50
RETAGUARDA_DOMAIN=loja1.tthreedigital.com.br

# Slug da empresa atendida (1 retaguarda = 1 restaurante / 1 filial)
EMPRESA_SLUG=top-cozinha-oriental

# ID único desta instalação (UUID v4 — gere com `uuidgen`)
RETAGUARDA_ID=00000000-0000-0000-0000-000000000000

# Token compartilhado pro heartbeat. Configurar igual no master (env HEARTBEAT_SECRET).
HEARTBEAT_SECRET=troque-este-secret-em-producao

# Portas locais (default 80/443). Mude se houver outro serviço.
LISTEN_HTTP=80
LISTEN_HTTPS=443

# Limites de cache em disco
CACHE_MAX_HTML=200m
CACHE_MAX_MEDIA=5g
CACHE_MAX_STATIC=500m

# ─── Cloudflare Tunnel (gerado por install.sh, não preencher à mão) ────────
TUNNEL_ID=
TUNNEL_TOKEN=
