# ─────────────────────────────────────────────────────────────────────────────
# Cardápio SaaS — Slave — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ─────────────────────────────────────────────────────────────────────────────

# VPS — URL base da plataforma (não altere se usar o SaaS padrão)
VPS_URL=https://cardapio.yugochat.com.br

# Identificação da empresa
EMPRESA_CNPJ=00000000000100
EMPRESA_NOME=Meu Restaurante

# Chave de instalação — copie do painel Admin > Empresas > Configurar > Servidor Local
SLAVE_KEY=cole_aqui_a_chave_gerada_no_admin

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL local
# ─────────────────────────────────────────────────────────────────────────────

DB_HOST=postgres
DB_PORT=5432
DB_NAME=cardapio_slave
DB_USER=cardapio
DB_PASSWORD=senha_local_forte_aqui

# ─────────────────────────────────────────────────────────────────────────────
# JWT — deve ser o mesmo secret configurado na VPS
# Necessário para que o Next.js local valide os tokens de login
# ─────────────────────────────────────────────────────────────────────────────

JWT_SECRET=
JWT_REFRESH_SECRET=
SLAVE_JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Sincronização
# ─────────────────────────────────────────────────────────────────────────────

# Intervalo de sincronização em milissegundos (padrão: 30 segundos)
SYNC_INTERVAL_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# Impressoras — JSON com configuração por setor
#
# Tipos suportados:
#   network: impressora de rede via IP/TCP (porta padrão 9100)
#   usb:     impressora USB (requer vendorId e productId)
#
# Setores disponíveis: totem, balcao, cozinha, producao, bar
#
# Exemplo completo:
# PRINTERS={"totem":{"type":"network","host":"192.168.1.100","port":9100},"balcao":{"type":"network","host":"192.168.1.101","port":9100},"cozinha":{"type":"network","host":"192.168.1.102","port":9100},"producao":{"type":"usb","vendorId":"0x04b8","productId":"0x0e15"},"bar":{"type":"network","host":"192.168.1.103","port":9100}}
# ─────────────────────────────────────────────────────────────────────────────

PRINTERS={"totem":{"type":"network","host":"192.168.1.100","port":9100},"cozinha":{"type":"network","host":"192.168.1.102","port":9100}}

# ─────────────────────────────────────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────────────────────────────────────

LOG_LEVEL=info
