{
  "name": "cardapio-slave",
  "version": "1.0.0",
  "description": "Cardápio SaaS — Agente Slave para Windows",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "build:exe": "pkg index.js --targets node18-win-x64 --output dist/cardapio-slave.exe --compress GZip",
    "build:all": "pkg index.js --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output dist/cardapio-slave --compress GZip"
  },
  "pkg": {
    "assets": [
      "setup-wizard/**/*",
      "node_modules/escpos/**/*"
    ],
    "scripts": [],
    "targets": ["node18-win-x64"]
  },
  "dependencies": {
    "express": "^4.18.2",
    "node-fetch": "^2.7.0",
    "ws": "^8.16.0",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4",
    "escpos-network": "^3.0.0-alpha.4",
    "node-thermal-printer": "^4.4.0",
    "open": "^8.4.2",
    "conf": "^10.2.0",
    "systray2": "^2.0.12",
    "node-windows": "^1.0.0-beta.8",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
